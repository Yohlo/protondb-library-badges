{
  "compilerOptions": {
    "outDir": ".millennium/Dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
